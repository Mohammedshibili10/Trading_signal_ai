node_modules/
.next/
dist/
build/
out/
coverage/

# Every env file is ignored, then the template is allowed back. The previous
# list named `.env` and `.env.*.local` specifically, which left `.env.production`
# — the one holding live credentials — tracked.
.env*
!.env.example

*.log
npm-debug.log*
yarn-error.log*
pnpm-debug.log*

.DS_Store
Thumbs.db

.vscode/*
!.vscode/extensions.json
.idea/

__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.model_cache/

apps/api/prisma/*.db
postgres-data/
redis-data/
.turbo/
tsconfig.tsbuildinfo
next-env.d.ts

# Database dumps: user rows, password hashes, API-linked data. Never committed.
backups/
*.sql.gz
*.dump

# Database dumps, wherever they land. A stray `pg_dump > backup.sql` in the
# repo root would otherwise be committed — and a dump carries every user row
# and password hash. Prisma migrations are .sql too, so they are excepted:
# they are source, not data.
*.sql
!apps/api/prisma/migrations/**/*.sql
