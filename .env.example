# ─────────────────────────────────────────────────────────────
#  AI Trading Intelligence Platform — environment template
#  Copy to `.env` and adjust. Everything below has a working
#  default, so the stack boots with zero external accounts.
# ─────────────────────────────────────────────────────────────

# ── Core infrastructure ──────────────────────────────────────
DATABASE_URL="postgresql://tip:tip_password@localhost:5432/tip?schema=public"
REDIS_URL="redis://localhost:6379"

# ── API (NestJS) ─────────────────────────────────────────────
API_PORT=4000
NODE_ENV=development
# CHANGE THESE IN PRODUCTION — use `openssl rand -base64 48`
JWT_ACCESS_SECRET="dev-access-secret-change-me-in-production"
JWT_REFRESH_SECRET="dev-refresh-secret-change-me-in-production"
JWT_ACCESS_TTL="15m"
JWT_REFRESH_TTL="30d"
COOKIE_DOMAIN="localhost"
CORS_ORIGINS="http://localhost:3000"

# Rate limiting (requests / window-seconds)
RATE_LIMIT_TTL=60
RATE_LIMIT_LIMIT=120

# ── Google OAuth (optional — login button hides when unset) ──
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_CALLBACK_URL="http://localhost:4000/api/v1/auth/google/callback"

# ── Email (optional — falls back to console transport) ───────
SMTP_HOST=""
SMTP_PORT=587
SMTP_USER=""
SMTP_PASSWORD=""
MAIL_FROM="AI Trading Intelligence <no-reply@example.com>"

# ── Market data ──────────────────────────────────────────────
# Provider chain, first match wins. Options: yahoo | alphavantage | finnhub | simulated
# `simulated` is a deterministic offline generator — always the final fallback.
MARKET_DATA_PROVIDERS="yahoo,simulated"
ALPHA_VANTAGE_API_KEY=""
FINNHUB_API_KEY=""
# Seconds a quote stays warm in Redis
QUOTE_CACHE_TTL=15
CANDLE_CACHE_TTL=300

# ── News ─────────────────────────────────────────────────────
# Options: rss (no key needed) | newsapi
NEWS_PROVIDERS="rss"
NEWSAPI_KEY=""

# ── AI service (FastAPI) ─────────────────────────────────────
AI_SERVICE_URL="http://localhost:8000"
AI_SERVICE_TOKEN="dev-ai-service-token-change-me"
AI_PORT=8000
# Set to 1 to download FinBERT (~440MB) for transformer sentiment.
# When 0, a fast finance-tuned lexicon model is used instead.
ENABLE_FINBERT=0
FINBERT_MODEL="ProsusAI/finbert"
MODEL_CACHE_DIR="./.model_cache"

# ── LLM for the AI assistant (optional) ──────────────────────
# Google Gemini. Get a key at https://aistudio.google.com/apikey
# Without a key the assistant still works — it answers from the
# deterministic analysis engine using templates instead of prose.
# The LLM only ever rephrases engine output; it never invents
# numbers or makes calls of its own.
GEMINI_API_KEY=""
ASSISTANT_MODEL="gemini-flash-latest"

# ── Telegram signal delivery (optional) ──────────────────────
# Create a bot: open Telegram, message @BotFather, send /newbot,
# follow the prompts, and paste the token it gives you here.
# Then in the app: Settings → Notifications → Connect Telegram.
TELEGRAM_BOT_TOKEN=""

# ── Autonomous background scanning ───────────────────────────
# The scanner runs every AUTOSCAN_INTERVAL_MINUTES, covers a rotating
# slice of watched instruments, and only issues a signal when the
# multi-timeframe gate and the six-condition checklist both pass.
AUTOSCAN_ENABLED=true
AUTOSCAN_INTERVAL_MINUTES=5

# ── Web (Next.js) ────────────────────────────────────────────
NEXT_PUBLIC_API_URL="http://localhost:4000/api/v1"
NEXT_PUBLIC_WS_URL="http://localhost:4000"
NEXT_PUBLIC_APP_NAME="Alphaline"
