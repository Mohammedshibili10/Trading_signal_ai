{
  "name": "trading-intelligence-platform",
  "version": "1.0.0",
  "private": true,
  "description": "AI Trading Intelligence Platform — market data, technical/fundamental analysis, AI signals, risk management and portfolio tools.",
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "concurrently -n web,api,ai -c cyan,magenta,yellow \"npm:dev:web\" \"npm:dev:api\" \"npm:ai\"",
    "dev:web": "npm run dev --workspace=@tip/web",
    "dev:api": "npm run start:dev --workspace=@tip/api",
    "ai": "node services/ai/run.mjs",
    "ai:test": "node services/ai/run.mjs --test",
    "ai:ml": "node services/ai/run.mjs --ml",
    "build": "npm run build --workspace=@tip/api && npm run build --workspace=@tip/web",
    "lint": "npm run lint --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "db:generate": "npm run prisma:generate --workspace=@tip/api",
    "db:migrate": "npm run prisma:migrate --workspace=@tip/api",
    "db:seed": "npm run prisma:seed --workspace=@tip/api",
    "db:studio": "npm run prisma:studio --workspace=@tip/api",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "docker:infra": "docker compose up -d postgres redis"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  },
  "engines": {
    "node": ">=22.11.0 <23"
  }
}
